{
  "expo": {
    "name": "Tempo",
    "slug": "tempo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tempo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tempo.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.tempo.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "daily-briefing"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "28e5f37d-f69d-4177-af43-f9f226123374"
      }
    }
  }
}
