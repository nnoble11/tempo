{
  "expo": {
    "name": "Tempo",
    "slug": "tempo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tempo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nathannoble.tempo",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Tempo reads event times only to find optional free windows. Event titles, locations, attendees, and notes never leave this device.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "28e5f37d-f69d-4177-af43-f9f226123374"
      }
    }
  }
}
